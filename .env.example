# Botpresso Docker Load Balancer Configuration
PORT=8000
NODE_ENV=production

# Backend Host & Port Mapping
APP_A_HOST=botpresso-app-a
APP_A_PORT=8080
APP_A_DOCKER_NAME=botpresso-app-a

APP_B_HOST=botpresso-app-b
APP_B_PORT=8080
APP_B_DOCKER_NAME=botpresso-app-b

# Health & Draining Timeouts
HEALTH_CHECK_INTERVAL_MS=1000
HEALTH_CHECK_TIMEOUT_MS=1500
DRAIN_TIMEOUT_MS=5000
ROLLOUT_HEALTH_TIMEOUT_MS=12000
PROXY_TIMEOUT_MS=10000

# Docker Socket Path
DOCKER_SOCKET_PATH=/var/run/docker.sock
